#!/bin/bash
set -euo pipefail
umask 077

ROOT=$(cd "$(dirname "$0")" && pwd -P)
SOURCE="$ROOT/src/rtl9210_health_probe.m"
BINARY="$ROOT/.build/rtl9210_health_probe"
RUNS="$ROOT/runs"
CONFIG_PATH="$ROOT/config/device.plist"
ASKPASS="$ROOT/scripts/macos-sudo-askpass"
VOLUME_GUARD="$ROOT/scripts/volume_guard.py"
PYTHON=""
VOLUME_MANIFEST=""
LOCK_HELD=0

BOUNDED="$ROOT/scripts/bounded.py"
PROBE_RECEIPT=""
PROBE_PENDING=0
MUTATION_PENDING=0
MUTATION_RECEIPT=""
RECOVERY_FAILED=0
CAPTURE_LOG=""
WORKER_DIR=""
WORKER_STARTED=0
WORKER_LAUNCH_PID=0
WORKER_CLIENT_PID=0

bounded() { "$PYTHON" -I "$BOUNDED" "$1" - "${@:2}"; }
diskutil() { bounded 20 /usr/sbin/diskutil "$@"; }
mutate_disk() {
    local result=0
    MUTATION_RECEIPT="$LAST_OPERATION_DIR/$1-exited"
    MUTATION_PENDING=1
    "$PYTHON" -I "$BOUNDED" 25 "$MUTATION_RECEIPT" /usr/sbin/diskutil "$@" || result=$?
    if ! "$PYTHON" -I "$BOUNDED" --check-complete "$MUTATION_RECEIPT"; then
        RECOVERY_FAILED=1
        return 125
    fi
    MUTATION_PENDING=0
    return "$result"
}
LAST_OPERATION_DIR=""


capture_preflight() {
    PYTHON=$(command -v python3) || die "Python 3.9+ required"
    # Resolve the interpreter without importing any project code.
    PYTHON=$("$PYTHON" -I -c 'import os,sys; print(os.path.realpath(sys.executable))')
    [[ ! -L "$ROOT/scripts" && ! -L "$ROOT/scripts/storage_guard.py" ]] || die "symlinked preflight helper"
    "$PYTHON" -I "$ROOT/scripts/storage_guard.py" "$ROOT" || die "internal storage preflight failed"
    if ! mkdir "$ROOT/.capture-lock" 2>/dev/null; then
        die "capture lock exists; inspect prior capture before removing it manually"
    fi
    LOCK_HELD=1
    trap cleanup EXIT
    trap 'exit 130' INT TERM HUP
}

# Public Realtek bridge identity used only for first-time enrollment.
ENROLL_USB_VID="0x0bda"
ENROLL_USB_PID="0x9210"

EXPECTED_MEDIA_NAME=""
EXPECTED_SIZE=""
EXPECTED_VOLUME_UUID=""
EXPECTED_MOUNT=""
EXPECTED_USB_VID=""
EXPECTED_USB_PID=""
EXPECTED_USB_BCD=""
EXPECTED_USB_SERIAL=""
EXPECTED_NVME_MODEL=""
EXPECTED_NVME_SERIAL=""

die() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

plist_stdin_value() {
    /usr/bin/plutil -extract "$2" raw -o - - <<<"$1"
}

profile_value() {
    local key=$1
    /usr/bin/plutil -extract "$key" raw -o - "$CONFIG_PATH" 2>/dev/null ||
        die "device profile is missing required key: $key"
}

private_value() {
    local file=$1 key=$2
    /usr/bin/plutil -extract "$key" raw -o - "$file" 2>/dev/null ||
        die "private enrollment result is incomplete"
}

validate_profile() {
    [[ -n "$EXPECTED_MEDIA_NAME" && ${#EXPECTED_MEDIA_NAME} -le 128 ]] ||
        die "invalid media_name in device profile"
    [[ "$EXPECTED_SIZE" =~ ^[0-9]+$ && "$EXPECTED_SIZE" -gt 0 ]] ||
        die "invalid physical_size_bytes in device profile"
    [[ "$EXPECTED_VOLUME_UUID" =~ ^[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}$ ]] ||
        die "invalid volume_uuid in device profile"
    [[ "$EXPECTED_MOUNT" == /Volumes/* && "$EXPECTED_MOUNT" != *$'\n'* ]] ||
        die "invalid mount_path in device profile"
    [[ "$EXPECTED_USB_VID" =~ ^0x[[:xdigit:]]{4}$ ]] ||
        die "invalid usb_vid in device profile"
    [[ "$EXPECTED_USB_PID" =~ ^0x[[:xdigit:]]{4}$ ]] ||
        die "invalid usb_pid in device profile"
    [[ "$EXPECTED_USB_BCD" =~ ^0x[[:xdigit:]]{4}$ ]] ||
        die "invalid usb_bcd in device profile"
    [[ -n "$EXPECTED_USB_SERIAL" && ${#EXPECTED_USB_SERIAL} -le 127 ]] ||
        die "invalid usb_serial in device profile"
    [[ -n "$EXPECTED_NVME_MODEL" && ${#EXPECTED_NVME_MODEL} -le 40 ]] ||
        die "invalid nvme_model in device profile"
    [[ -n "$EXPECTED_NVME_SERIAL" && ${#EXPECTED_NVME_SERIAL} -le 20 ]] ||
        die "invalid nvme_serial in device profile"
}

load_profile() {
    local permissions
    [[ -f "$CONFIG_PATH" ]] ||
        die "no enrolled device profile; run ./rtl9210-health setup"
    [[ ! -L "$CONFIG_PATH" ]] || die "refusing a symlinked device profile"
    permissions=$(/usr/bin/stat -f '%Lp' "$CONFIG_PATH")
    [[ "$permissions" =~ ^[0-7]{3,4}$ ]] ||
        die "could not validate device profile permissions"
    (( 10#$permissions % 100 == 0 )) ||
        die "device profile must not be readable by group or others (use chmod 600)"

    EXPECTED_MEDIA_NAME=$(profile_value media_name)
    EXPECTED_SIZE=$(profile_value physical_size_bytes)
    EXPECTED_VOLUME_UUID=$(profile_value volume_uuid)
    EXPECTED_MOUNT=$(profile_value mount_path)
    EXPECTED_USB_VID=$(profile_value usb_vid)
    EXPECTED_USB_PID=$(profile_value usb_pid)
    EXPECTED_USB_BCD=$(profile_value usb_bcd)
    EXPECTED_USB_SERIAL=$(profile_value usb_serial)
    EXPECTED_NVME_MODEL=$(profile_value nvme_model)
    EXPECTED_NVME_SERIAL=$(profile_value nvme_serial)
    validate_profile
}

resolve_disk() {
    local candidate info media size protocol whole
    local matches=()
    while read -r candidate _; do
        [[ "$candidate" =~ ^/dev/disk[0-9]+$ ]] || continue
        info=$(diskutil info -plist "$candidate" 2>/dev/null) || continue
        media=$(plist_stdin_value "$info" MediaName 2>/dev/null || true)
        size=$(plist_stdin_value "$info" IOKitSize 2>/dev/null || true)
        protocol=$(plist_stdin_value "$info" BusProtocol 2>/dev/null || true)
        whole=$(plist_stdin_value "$info" WholeDisk 2>/dev/null || true)
        if [[ "$media" == "$EXPECTED_MEDIA_NAME" &&
              "$size" == "$EXPECTED_SIZE" &&
              "$protocol" == "USB" && "$whole" == "true" ]]; then
            matches+=("$candidate")
        fi
    done < <(diskutil list external physical)

    [[ ${#matches[@]} -eq 1 ]] ||
        die "expected one enrolled RTL9210 disk; found ${#matches[@]}"
    printf '%s\n' "${matches[0]}"
}

mounted_volume_matches() {
    local disk=$1 info mount store disk_name
    info=$(diskutil info -plist "$EXPECTED_VOLUME_UUID" 2>/dev/null) ||
        return 1
    mount=$(plist_stdin_value "$info" MountPoint 2>/dev/null) || return 1
    store=$(plist_stdin_value "$info" APFSPhysicalStores.0.APFSPhysicalStore \
        2>/dev/null) || return 1
    disk_name=${disk#/dev/}
    [[ "$mount" == "$EXPECTED_MOUNT" && "$store" == "$disk_name"s* ]]
}

verify_mounted_volume() {
    local disk=$1
    mounted_volume_matches "$disk" ||
        die "enrolled volume is not mounted from the expected physical store"
}

wait_for_mounted_volume() {
    local disk=""
    for _ in {1..30}; do
        disk=$(resolve_disk 2>/dev/null || true)
        if [[ -n "$disk" ]] && mounted_volume_matches "$disk"; then
            return 0
        fi
        sleep 1
    done
    die "enrolled volume did not return from the expected physical store"
}

time_machine_state() {
    local output state
    output=$(bounded 15 /usr/bin/tmutil status) ||
        die "could not establish Time Machine state"
    state=$(printf '%s\n' "$output" | /usr/bin/awk -F'= ' \
        '/Running/{gsub(/[; ]/,"",$2); print $2; exit}')
    case "$state" in
        0) printf 'idle\n' ;;
        1) printf 'running\n' ;;
        *) die "could not establish Time Machine state" ;;
    esac
}

require_time_machine_idle() {
    local state
    state=$(time_machine_state)
    [[ "$state" == "idle" ]] ||
        die "Time Machine is running; retry after it finishes"
}

build_if_needed() {
    [[ "$ROOT" != /Volumes/* ]] || die "store tool on internal disk before building"
    mkdir -p "$ROOT/.build"
    if [[ ! -x "$BINARY" || "$SOURCE" -nt "$BINARY" || "$ROOT/src/cancellation.h" -nt "$BINARY" ]]; then
        printf 'Building native probe…\n'
        /usr/bin/xcrun clang -arch arm64 -mmacosx-version-min=15.0 -fobjc-arc -Wall -Wextra -Werror \
            -framework Foundation -framework IOKit -framework IOUSBHost \
            "$SOURCE" -o "$BINARY"
    fi
}

wait_worker() {
    local mode=$1 seconds=$2 result=0
    "$PYTHON" -I "$ROOT/scripts/worker_client.py" "$mode" "$WORKER_DIR" "$seconds" "$WORKER_LAUNCH_PID" &
    WORKER_CLIENT_PID=$!
    # Bash wait is interruptible; a foreground external command would defer traps.
    wait "$WORKER_CLIENT_PID" || result=$?
    WORKER_CLIENT_PID=0
    return "$result"
}

start_worker() {
    local mode=$1 disk=$2 binding=$3 directory=$4
    [[ -x "$ASKPASS" ]] || die "macOS authorization helper is unavailable"
    WORKER_DIR=$directory
    WORKER_STARTED=1
    # Authorize the actual worker once. No cached authorization is transferred
    # across sessions, and no later sudo invocation occurs after unmount.
    # Intentionally keep the launcher log owned/opened by the unprivileged caller.
    # shellcheck disable=SC2024
    SUDO_ASKPASS="$ASKPASS" /usr/bin/sudo -A "$PYTHON" -I "$ROOT/scripts/privileged_worker.py" \
        "$ROOT" "$directory" "$mode" "$disk" "$binding" "$ENROLL_USB_VID" "$ENROLL_USB_PID" \
        "$UID" "$(/usr/bin/id -g)" "$$" >> "$directory/worker.log" 2>&1 &
    WORKER_LAUNCH_PID=$!
    wait_worker ready 90 ||
        die "authorized worker handshake failed; no unmount attempted"
}

settle_worker() {
    [[ $WORKER_STARTED -eq 1 ]] || return 0
    : > "$WORKER_DIR/cancel.request"
    if [[ $WORKER_CLIENT_PID -gt 0 ]]; then
        # Only our unprivileged waiting client is signalled, never sudo/root processes.
        kill -TERM "$WORKER_CLIENT_PID" 2>/dev/null || true
        wait "$WORKER_CLIENT_PID" 2>/dev/null || true
        WORKER_CLIENT_PID=0
    fi
    if ! wait_worker "done" 170; then
        RECOVERY_FAILED=1
        return 1
    fi
    WORKER_STARTED=0
    PROBE_PENDING=0  # Actual privileged owner confirmed no native child remains.
}

show_status() {
    local disk info used free latest_health tm_state
    disk=$(resolve_disk)
    verify_mounted_volume "$disk"
    info=$(diskutil info -plist "$EXPECTED_VOLUME_UUID")
    used=$(plist_stdin_value "$info" CapacityInUse)
    free=$(plist_stdin_value "$info" APFSContainerFree)

    printf '\nRTL9210 Health Monitor\n'
    printf '  Disk             %s (%s bytes)\n' "$disk" "$EXPECTED_SIZE"
    printf '  Volume           mounted and identity-verified\n'
    printf '  APFS used/free   %s / %s bytes\n' "$used" "$free"
    tm_state=$(time_machine_state)
    printf '  Time Machine     %s\n' "$tm_state"
    if [[ -L "$ROOT/latest" ]]; then
        latest_health=$(readlink "$ROOT/latest")
        printf '  Latest health    %s\n' "$latest_health"
    else
        printf '  Latest health    none\n'
    fi
    printf '\n'
}

NEEDS_RESTORE=0

restore_disk() {
    local disk="" identity_rc ready=0 deadline=$((SECONDS + 90))
    [[ $NEEDS_RESTORE -eq 1 ]] || return 0
    # Mark incomplete BEFORE clearing the pending flag: signals can arrive between commands.
    RECOVERY_FAILED=1
    NEEDS_RESTORE=0
    if [[ $MUTATION_PENDING -eq 1 ]] && ! "$PYTHON" -I "$BOUNDED" --check-complete "$MUTATION_RECEIPT"; then
        printf 'RECOVERY BLOCKED: disk operation completion is ambiguous; no additional mutation.\n' >&2
        return 1
    fi
    if [[ $PROBE_PENDING -eq 1 && ! -f "$PROBE_RECEIPT" ]]; then
        printf 'RECOVERY BLOCKED: probe exit unconfirmed; retaining lock, no mount attempted.\n' >&2
        RECOVERY_FAILED=1
        return 1
    fi
    PROBE_PENDING=0
    MUTATION_PENDING=0
    printf '\nRestoring and verifying all original volumes…\n' >&2
    while (( SECONDS < deadline )); do
        disk=$(resolve_disk 2>/dev/null || true)
        if [[ -n "$disk" ]]; then
            identity_rc=0
            bounded 35 "$PYTHON" -I "$VOLUME_GUARD" identity "$disk" "$VOLUME_MANIFEST" || identity_rc=$?
            if [[ $identity_rc -eq 0 ]]; then ready=1; break; fi
            if [[ $identity_rc -ne 75 ]]; then
                printf 'RECOVERY FAILED: identity mismatch or unverifiable inventory; no mount attempted.\n' >&2
                return 1
            fi
        fi
        sleep 1
    done
    [[ $ready -eq 1 ]] || { printf 'RECOVERY FAILED: volume discovery deadline expired.\n' >&2; return 1; }
    mutate_disk mountDisk "$disk" ||
        printf 'Mount request failed; checking actual volume state before declaring recovery.\n' >&2
    [[ $MUTATION_PENDING -eq 0 ]] || return 1
    deadline=$((SECONDS + 90))
    while (( SECONDS < deadline )); do
        disk=$(resolve_disk 2>/dev/null || true)
        if [[ -n "$disk" ]] && bounded 45 "$PYTHON" -I "$VOLUME_GUARD" verify "$disk" "$VOLUME_MANIFEST" >/dev/null 2>&1; then
            printf 'Recovery verified: all volume UUIDs, paths and physical store match.\n' >&2
            RECOVERY_FAILED=0
            return 0
        fi
        sleep 1
    done
    printf 'RECOVERY FAILED: one or more original volumes are missing or mismatched. Stop disk workloads; do not format or force repair.\n' >&2
    return 1
}

cleanup() {
    local rc=$?
    trap - EXIT
    trap '' INT TERM HUP
    # The actual root owner must confirm no child remains before any recovery.
    if settle_worker; then
        if ! restore_disk; then rc=70; RECOVERY_FAILED=1; fi
    else
        rc=70
    fi
    if [[ $RECOVERY_FAILED -eq 1 ]]; then rc=70; fi
    if [[ $LOCK_HELD -eq 1 && $RECOVERY_FAILED -eq 0 ]]; then rmdir "$ROOT/.capture-lock" 2>/dev/null || true; fi
    # Critical-phase output stays on internal storage until recovery/lock handling ends.
    # A stalled reader can delay this best-effort replay by at most its timeout.
    if [[ -n "$CAPTURE_LOG" ]]; then
        bounded 2 /bin/cat "$CAPTURE_LOG" >&3 2>&4 || true
    fi
    exit "$rc"
}

hash_run() {
    local run_dir=$1
    (
        cd "$run_dir"
        : > SHA256SUMS
        for file in identify_controller.bin smart_health_log.bin \
                    error_info_log.bin enrollment.plist summary.txt probe.log volumes-before.json child-exited release-status.plist unmountDisk-exited mountDisk-exited; do
            [[ -f "$file" ]] && LC_ALL=C /usr/bin/shasum -a 256 "$file" >> SHA256SUMS
        done
    )
}

LAST_RUN_DIR=""

perform_capture() {
    local mode=$1 disk=$2 run_id run_dir probe_rc verified_disk binding
    require_time_machine_idle
    verified_disk=$(resolve_disk)
    [[ "$verified_disk" == "$disk" ]] ||
        die "the selected physical disk changed before capture"
    verify_mounted_volume "$verified_disk"
    run_id=$(/bin/date '+%Y%m%d_%H%M%S')
    run_dir="$RUNS/$run_id"
    mkdir "$run_dir"  # Refuse timestamp collisions rather than overwrite evidence.
    LAST_OPERATION_DIR="$run_dir"
    VOLUME_MANIFEST="$run_dir/volumes-before.json"
    binding=$(bounded 10 "$BINARY" binding "$disk") || die "cannot bind disk to USB registry entry"
    [[ "$binding" =~ ^[0-9]+$ ]] || die "invalid USB registry binding"
    bounded 45 "$PYTHON" -I "$VOLUME_GUARD" snapshot "$disk" "$VOLUME_MANIFEST" "$EXPECTED_VOLUME_UUID"
    [[ "$(bounded 10 "$BINARY" binding "$disk")" == "$binding" ]] || die "USB binding changed during snapshot"
    # Redirect BEFORE any unmount. EXIT cleanup inherits these local log descriptors.
    CAPTURE_LOG="$run_dir/transaction.log"
    exec 3>&1 4>&2
    exec >> "$CAPTURE_LOG" 2>&1
    start_worker "$mode" "$disk" "$binding" "$run_dir"
    # Authorization can take time; revalidate after the actual worker is ready.
    [[ "$(resolve_disk)" == "$disk" ]] || die "disk changed during authorization"
    bounded 45 "$PYTHON" -I "$VOLUME_GUARD" verify "$disk" "$VOLUME_MANIFEST"
    [[ "$(bounded 10 "$BINARY" binding "$disk")" == "$binding" ]] || die "USB binding changed during authorization"
    wait_worker ready 2 || die "authorized worker is no longer ready; no unmount attempted"
    NEEDS_RESTORE=1
    trap cleanup EXIT
    trap 'exit 130' INT TERM HUP

    printf 'Unmounting %s…\n' "$disk"
    mutate_disk unmountDisk "$disk" >/dev/null ||
        die "could not unmount the selected disk"
    bounded 45 "$PYTHON" -I "$VOLUME_GUARD" unmounted "$disk" "$VOLUME_MANIFEST" ||
        die "whole-disk unmount could not be verified"

    printf 'Reading controller identity and health…\n\n'
    PROBE_RECEIPT="$run_dir/child-exited"
    PROBE_PENDING=1
    : > "$run_dir/probe.request"
    if ! wait_worker "done" 170; then
        die "privileged child completion unconfirmed"
    fi
    WORKER_STARTED=0
    PROBE_PENDING=0  # Worker acknowledgement is stronger than a child receipt file.
    probe_rc=$("$PYTHON" -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["returncode"])' "$run_dir/worker-done.json")
    if ! restore_disk; then
        RECOVERY_FAILED=1
        die "capture recovery failed; evidence retained, no repair attempted"
    fi
    # Receipt proves process exit, not that the native release path ran.
    if [[ "$(/usr/bin/plutil -extract release_path_completed raw -o - "$run_dir/release-status.plist" 2>/dev/null || true)" == true ]]; then
        printf 'Native release path completed; all volumes independently verified.\n'
    else
        printf 'Native release unconfirmed (forced exit or missing marker); volume recovery independently verified.\n'
        [[ $probe_rc -ne 0 ]] || probe_rc=1
    fi
    /bin/cat "$run_dir/probe.log" >&2
    /bin/cat "$run_dir/summary.txt"

    hash_run "$run_dir"
    verify_mounted_volume "$(resolve_disk)"
    [[ $probe_rc -eq 0 ]] || die "probe failed; private evidence was retained"
    LAST_RUN_DIR=$run_dir
}

verify_final_volumes() {
    local disk
    # Preserve the lock if interrupted during the final check or if any volume vanished.
    RECOVERY_FAILED=1
    disk=$(resolve_disk) || die "final physical disk verification failed"
    bounded 45 "$PYTHON" -I "$VOLUME_GUARD" verify "$disk" "$VOLUME_MANIFEST" ||
        die "final verification failed: all original volumes must still be mounted"
    RECOVERY_FAILED=0
}

update_latest() {
    "$PYTHON" -I - "$ROOT" "runs/${LAST_RUN_DIR##*/}" <<'PYCODE'
import os, sys
root, target = sys.argv[1:]
temporary = os.path.join(root, '.capture-lock', 'latest')
os.symlink(target, temporary)
try:
    os.replace(temporary, os.path.join(root, 'latest'))
finally:
    if os.path.lexists(temporary):
        os.unlink(temporary)
PYCODE
}

validate_profile_file() {
    local CONFIG_PATH=$1
    load_profile
}

write_profile() {
    local enrollment=$1 config_dir temp
    local enrolled_vid enrolled_pid enrolled_bcd enrolled_usb_serial
    local enrolled_nvme_model enrolled_nvme_serial

    enrolled_vid=$(private_value "$enrollment" usb_vid)
    enrolled_pid=$(private_value "$enrollment" usb_pid)
    enrolled_bcd=$(private_value "$enrollment" usb_bcd)
    enrolled_usb_serial=$(private_value "$enrollment" usb_serial)
    enrolled_nvme_model=$(private_value "$enrollment" nvme_model)
    enrolled_nvme_serial=$(private_value "$enrollment" nvme_serial)

    config_dir=$(/usr/bin/dirname "$CONFIG_PATH")
    mkdir -p "$config_dir"
    temp=$(/usr/bin/mktemp "$config_dir/.device.plist.XXXXXX")
    /usr/bin/plutil -create xml1 "$temp"
    /usr/bin/plutil -insert media_name -string "$EXPECTED_MEDIA_NAME" "$temp"
    /usr/bin/plutil -insert physical_size_bytes -integer "$EXPECTED_SIZE" "$temp"
    /usr/bin/plutil -insert volume_uuid -string "$EXPECTED_VOLUME_UUID" "$temp"
    /usr/bin/plutil -insert mount_path -string "$EXPECTED_MOUNT" "$temp"
    /usr/bin/plutil -insert usb_vid -string "$enrolled_vid" "$temp"
    /usr/bin/plutil -insert usb_pid -string "$enrolled_pid" "$temp"
    /usr/bin/plutil -insert usb_bcd -string "$enrolled_bcd" "$temp"
    /usr/bin/plutil -insert usb_serial -string "$enrolled_usb_serial" "$temp"
    /usr/bin/plutil -insert nvme_model -string "$enrolled_nvme_model" "$temp"
    /usr/bin/plutil -insert nvme_serial -string "$enrolled_nvme_serial" "$temp"
    /bin/chmod 600 "$temp"
    # Validate the candidate before replacing a previously valid enrollment.
    if ! (validate_profile_file "$temp"); then
        /bin/rm -f "$temp"
        die "invalid enrollment result; previous device profile preserved"
    fi
    /bin/mv -f "$temp" "$CONFIG_PATH"
}

show_setup_candidates() {
    local candidate info media size protocol whole
    printf '\nConnected external physical USB disks:\n'
    while read -r candidate _; do
        [[ "$candidate" =~ ^/dev/disk[0-9]+$ ]] || continue
        info=$(diskutil info -plist "$candidate" 2>/dev/null) || continue
        protocol=$(plist_stdin_value "$info" BusProtocol 2>/dev/null || true)
        whole=$(plist_stdin_value "$info" WholeDisk 2>/dev/null || true)
        [[ "$protocol" == "USB" && "$whole" == "true" ]] || continue
        media=$(plist_stdin_value "$info" MediaName 2>/dev/null || true)
        size=$(plist_stdin_value "$info" IOKitSize 2>/dev/null || true)
        printf '  %-12s  %-28s  %s bytes\n' "$candidate" "$media" "$size"
    done < <(diskutil list external physical)
    printf '\n'
}

run_setup() {
    local supplied_disk="" supplied_volume="" preconfirmed=0 replace_confirmed=0
    local disk volume info protocol whole media size upper_media volume_info
    local mount volume_uuid store disk_name answer

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --disk)
                [[ $# -ge 2 ]] || die "--disk requires a value"
                supplied_disk=$2
                shift 2
                ;;
            --volume)
                [[ $# -ge 2 ]] || die "--volume requires a value"
                supplied_volume=$2
                shift 2
                ;;
            --confirm) preconfirmed=1; shift ;;
            --replace) replace_confirmed=1; shift ;;
            *) die "unknown setup option: $1" ;;
        esac
    done
    if [[ -n "$supplied_disk" || -n "$supplied_volume" ]]; then
        [[ -n "$supplied_disk" && -n "$supplied_volume" ]] ||
            die "--disk and --volume must be supplied together"
    fi

    [[ $EUID -ne 0 ]] || die "run this front door as your normal user, not sudo"
    require_time_machine_idle
    [[ ! -L "$CONFIG_PATH" ]] || die "refusing a symlinked device profile"

    if [[ -e "$CONFIG_PATH" ]]; then
        if [[ $replace_confirmed -eq 0 ]]; then
            read -r -p 'A local device profile exists. Type REPLACE to re-enroll: ' answer
            [[ "$answer" == "REPLACE" ]] || die "cancelled"
        fi
    fi

    if [[ -n "$supplied_disk" ]]; then
        disk=$supplied_disk
        volume=$supplied_volume
    else
        show_setup_candidates
        read -r -p 'Enter the exact RTL9210 device node shown above: ' disk
        read -r -p 'Enter one mounted APFS volume path on that disk: ' volume
    fi
    [[ "$disk" =~ ^/dev/disk[0-9]+$ ]] || die "invalid physical disk path"

    info=$(diskutil info -plist "$disk") ||
        die "selected disk is unavailable"
    protocol=$(plist_stdin_value "$info" BusProtocol 2>/dev/null || true)
    whole=$(plist_stdin_value "$info" WholeDisk 2>/dev/null || true)
    media=$(plist_stdin_value "$info" MediaName 2>/dev/null || true)
    size=$(plist_stdin_value "$info" IOKitSize 2>/dev/null || true)
    upper_media=$(printf '%s' "$media" | /usr/bin/tr '[:lower:]' '[:upper:]')
    [[ "$protocol" == "USB" && "$whole" == "true" ]] ||
        die "selected target is not an external whole USB disk"
    [[ "$upper_media" == *RTL9210* ]] ||
        die "selected disk does not identify as an RTL9210"
    [[ "$size" =~ ^[0-9]+$ && "$size" -gt 0 ]] ||
        die "selected disk has an invalid size"

    volume_info=$(diskutil info -plist "$volume") ||
        die "selected volume is unavailable"
    mount=$(plist_stdin_value "$volume_info" MountPoint 2>/dev/null || true)
    volume_uuid=$(plist_stdin_value "$volume_info" VolumeUUID 2>/dev/null || true)
    store=$(plist_stdin_value "$volume_info" APFSPhysicalStores.0.APFSPhysicalStore \
        2>/dev/null || true)
    disk_name=${disk#/dev/}
    [[ "$mount" == "$volume" && "$mount" == /Volumes/* ]] ||
        die "volume path is not an active /Volumes mount"
    [[ "$volume_uuid" =~ ^[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}$ ]] ||
        die "selected APFS volume has no valid volume UUID"
    [[ "$store" == "$disk_name"s* ]] ||
        die "selected volume is not backed by the selected physical disk"

    EXPECTED_MEDIA_NAME=$media
    EXPECTED_SIZE=$size
    EXPECTED_VOLUME_UUID=$volume_uuid
    EXPECTED_MOUNT=$mount

    printf '\nEnrollment target\n'
    printf '  Disk    %s\n' "$disk"
    printf '  Media   %s\n' "$media"
    printf '  Size    %s bytes\n' "$size"
    printf '  Volume  selected and physical-store verified\n\n'
    printf 'Disconnect any other RTL9210 enclosure before continuing.\n'
    if [[ $preconfirmed -eq 0 ]]; then
        read -r -p 'Type ENROLL to unmount and read this device: ' answer
        [[ "$answer" == "ENROLL" ]] || die "cancelled"
    fi

    mkdir -p "$RUNS"
    build_if_needed
    perform_capture enroll "$disk"
    [[ -f "$LAST_RUN_DIR/enrollment.plist" ]] ||
        die "probe succeeded without a private enrollment result"
    write_profile "$LAST_RUN_DIR/enrollment.plist"
    load_profile
    verify_mounted_volume "$(resolve_disk)"
    verify_final_volumes
    update_latest

    printf '\n✓ Enrollment and baseline health read complete\n'
    printf '  Local profile: config/device.plist (gitignored, mode 600)\n'
    printf '  Private run:   runs/%s\n\n' "${LAST_RUN_DIR##*/}"
}

run_probe() {
    local preconfirmed=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --confirm) preconfirmed=1; shift ;;
            *) die "unknown probe option: $1" ;;
        esac
    done
    [[ $EUID -ne 0 ]] || die "run this front door as your normal user, not sudo"
    require_time_machine_idle

    local disk answer
    disk=$(resolve_disk)
    verify_mounted_volume "$disk"
    build_if_needed

    printf '\nThis will briefly unmount the whole enrolled disk, read three NVMe pages, and verify all original volumes.\n'
    if [[ $preconfirmed -eq 0 ]]; then
        read -r -p 'Type PROBE to continue: ' answer
        [[ "$answer" == "PROBE" ]] || die "cancelled"
    fi

    mkdir -p "$RUNS"
    perform_capture probe "$disk"
    verify_final_volumes
    update_latest
    printf '\n✓ Health read complete\n  runs/%s\n\n' "${LAST_RUN_DIR##*/}"
}

usage() {
    printf 'Usage: %s {setup|status|probe}\n' "$(basename "$0")"
    printf '  setup   Enroll one explicitly selected RTL9210 and create a private profile.\n'
    printf '  status  Passively verify the enrolled disk and show local health state.\n'
    printf '  probe   Perform one guarded, read-only health capture.\n'
    printf '\nAutomation:\n'
    printf '  setup --disk /dev/diskN --volume /Volumes/Name --confirm\n'
    printf '  probe --confirm\n'
    printf '  Captures use a macOS authorization dialog; credentials are not logged.\n'
}

case "${1:-status}" in
    setup) capture_preflight; run_setup "${@:2}" ;;
    status) PYTHON=$(command -v python3); load_profile; show_status ;;
    probe) capture_preflight; load_profile; run_probe "${@:2}" ;;
    -h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
esac
